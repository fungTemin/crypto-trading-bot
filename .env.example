# Copy to .env and fill in your API keys
# Exchange API Keys
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_SECRET=your_secret_here
EXCHANGE_PASSWORD=your_password_if_needed

# For multiple exchanges, prefix with exchange id:
# BINANCE_API_KEY=
# BINANCE_SECRET=
# OKX_API_KEY=
# OKX_SECRET=
# OKX_PASSWORD=

# Trading mode: paper | live | backtest
TRADING_MODE=paper

# Override exchange
# EXCHANGE_ID=binance
# MARKET_TYPE=spot
