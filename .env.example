# Copy to .env and fill in your API keys

# ============================================
# Exchange API Keys
# ============================================

# Default exchange keys (used when EXCHANGE_ID is not set)
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_SECRET=your_secret_here
EXCHANGE_PASSWORD=your_password_if_needed

# ============================================
# OKX Configuration
# ============================================
# Get API keys from: https://www.okx.com/account/my-api
OKX_API_KEY=your_okx_api_key
OKX_SECRET=your_okx_secret_key
OKX_PASSWORD=your_okx_passphrase

# OKX Demo Trading (for testing without real money)
# Set to 'true' to use OKX demo environment
OKX_SANDBOX=true

# ============================================
# Binance Configuration
# ============================================
# Get API keys from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET=your_binance_secret

# ============================================
# Trading Mode
# ============================================
# paper   - Simulated trading (no real orders)
# live    - Real trading with actual funds
# backtest - Historical backtesting
TRADING_MODE=paper

# ============================================
# Override Settings
# ============================================
# EXCHANGE_ID=okx
# MARKET_TYPE=spot
# CONFIG_PATH=config
